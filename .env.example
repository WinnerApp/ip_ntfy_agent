# Appwrite
APPWRITE_ENDPOINT=https://appwrite.winnermedical.com/v1
APPWRITE_PROJECT_ID=677f626b0012252b422e
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=6a6aaced00065290a69c
APPWRITE_COLLECTION_ID=6a6aacfb00024a65ba3d
# Hot-update zip bucket + metadata collection (tag / fileId / buildId)
APPWRITE_BUCKET_ID=6a6b20d0002630974471
APPWRITE_RESOURCE_COLLECTION_ID=6a6b2e2c001091ff8ef0
APPWRITE_SELF_SIGNED=false

# Collection field names / query
# Host doc fields: url, userName, password, active, tag, online
# tag: test = 测试打包机, release = 生产打包机
APPWRITE_TAG_VALUE=test
APPWRITE_URL_ATTR=url
APPWRITE_USERNAME_ATTR=userName
APPWRITE_PASSWORD_ATTR=password
APPWRITE_ACTIVE_ATTR=active
APPWRITE_ONLINE_ATTR=online

# ntfy
NTFY_BASE_URL=https://ntfy.sh
# Optional auth header value, e.g. Bearer <token>
NTFY_AUTH=

# Feishu custom bot webhook (optional; leave empty to disable)
# e.g. https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_WEBHOOK_URL=

# Intervals (seconds)
IP_CHECK_INTERVAL_SECONDS=5
JENKINS_CHECK_INTERVAL_SECONDS=60
